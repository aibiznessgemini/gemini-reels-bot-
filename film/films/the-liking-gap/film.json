    },
    {
      "id": "s02",
      "line": "Did I talk too much? Was that joke weird? Do they think I'm boring?",
      "set": "hall",
      "shot": "closeup",
      "crowd": 30,
      "expression": {
        "you": "nervous"
      },
      "audio": "voice/the-liking-gap/s02.mp3",
      "duration": 5.56
    },
    {
      "id": "s03",
      "line": "Now imagine you could see exactly what they were thinking about you.",
      "set": "hall",
      "shot": "ots",
      "others": [
        "maya"
      ],
      "crowd": 30,
