      ],
      "audio": "voice/the-liking-gap/s03.mp3",
      "duration": 5.01
    },
    {
      "id": "s04",
      "line": "Say every person you met gave you a secret score, from one to ten.",
      "set": "void",
      "shot": "lineup",
      "others": [
        "maya"
      ],
      "nameTags": true,
      "label": "a secret score",
      "counter": {
