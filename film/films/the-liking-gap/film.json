      "duration": 4.86
    },
    {
      "id": "s24",
      "line": "The researchers called it a rare kind of pessimism. We're usually confident about ourselves... but not in conversation.",
      "set": "street",
      "shot": "closeup",
      "crowd": 8,
      "expression": {
        "you": "neutral>surprised"
      },
      "audio": "voice/the-liking-gap/s24.mp3",
      "duration": 9.17
    },
    {
      "id": "s25",
      "line": "So the next time you walk away from a chat, convinced it went badly...",
      "set": "hall",
      "shot": "wide",
